// ============================================================
// EPOS Au+Au 200 GeV analysis - 3D Levy fits with cutoff loop
//   * on-shell pion energy (the 'e' branch is NOT the energy)
//   * Poisson deviance on RAW COUNTS, normalised to the full
//     source up to rho_max^lambda (so lambda depends on the cutoff)
//   * integrated bin prediction (Simpson), core-only fit range
// Run:  root -l -b -q epos_hbt_3D_robust.C
// ============================================================
#include <TFile.h>
#include <TTree.h>
#include <TChain.h>
#include <TCanvas.h>
#include <TH1F.h>
#include <TF1.h>
#include <TSystem.h>
#include <TString.h>
#include <TMath.h>
#include <TStyle.h>
#include <TRandom.h>
#include <TStopwatch.h>
#include <TGraphErrors.h>
#include <TPaveText.h>
#include <TLegend.h>
#include <TLine.h>
#include <Math/Minimizer.h>
#include <Math/Factory.h>
#include <Math/Functor.h>
#include <iostream>
#include <iomanip>
#include <vector>
#include <map>
#include <cmath>
#include <algorithm>
#include <fstream>
#include <limits>

#include "Levy_proj_reader.h"

using namespace std;

// ============ Configuration ============
const double m_pi = 0.13957;
const double pT_min  = 0.15;
const double pT_max  = 1.0;
const double eta_cut = 1.0;
const int    NPAR    = 5;

// kT bins (set kT_hi_edge = 0.20 for a one-bin test run)
const double kT_bin_width = 0.05;
const double kT_lo_edge   = 0.15;
const double kT_hi_edge   = 0.85;
const int    nBins_kT = (int)((kT_hi_edge - kT_lo_edge) / kT_bin_width + 0.5);

// rho_max^lambda cutoffs; entry 0 is the reference ("1mm")
vector<pair<string, double>> rhoLambdaCutoffs = {
    {"1mm",   1.0e12},
    {"5mm",   5.0e12},
    {"5cm",   5.0e13},
    {"50cm",  5.0e14}
};

// Levy projection reader
Levy_reader* myLevy_reader;

double LevyProj1DFunc(const double *x, const double *par) {
    double alpha = par[0];
    double R     = par[1];
    double N     = par[2];
    double Rcc   = R * pow(2., 1./alpha);
    return (2.*N / Rcc) * myLevy_reader->getValue_1d(alpha, x[0]/Rcc);
}

// Integral of the Levy projection over one histogram bin (Simpson)
double IntegralLevyBin(double alpha, double R, double lambda, double xlow, double xhigh)
{
    const int nsub = 8;
    if (xhigh <= xlow) return 0.0;
    const double dx = (xhigh - xlow) / nsub;
    const double pars[3] = {alpha, R, lambda};
    double sum = 0.0;
    for (int k = 0; k <= nsub; ++k) {
        const double x = xlow + k*dx;
        double w = (k == 0 || k == nsub) ? 1.0 : ((k % 2) ? 4.0 : 2.0);
        sum += w * LevyProj1DFunc(&x, pars);
    }
    return sum * dx / 3.0;
}

// ============ Poisson deviance on raw counts ============
class LogLikelihood {
public:
    LogLikelihood(TH1F* hOut, TH1F* hSide, TH1F* hLong,
                  double xmin, double xmax, double rhoLamMax)
    {
        TH1F* hs[3] = {hOut, hSide, hLong};
        for (int i = 0; i < 3; ++i) {
            int last = hs[i]->FindBin(rhoLamMax);
            if (last > hs[i]->GetNbinsX()) last = hs[i]->GetNbinsX();
            norm_[i] = hs[i]->Integral(0, last);          // raw counts, no "width"
            for (int b = 1; b <= hs[i]->GetNbinsX(); ++b) {
                double xc = hs[i]->GetBinCenter(b);
                if (xc < xmin || xc > xmax) continue;
                lo_[i].push_back(hs[i]->GetBinLowEdge(b));
                hi_[i].push_back(hs[i]->GetBinLowEdge(b + 1));
                obs_[i].push_back(hs[i]->GetBinContent(b));
            }
        }
    }
    int nBins() const { return (int)(lo_[0].size() + lo_[1].size() + lo_[2].size()); }

    double operator()(const double* p) const {
        double dev = 0.0;
        for (int i = 0; i < 3; ++i) {
            if (!(norm_[i] > 0.0)) return 1.0e100;
            for (size_t k = 0; k < lo_[i].size(); ++k) {
                double e = norm_[i] * IntegralLevyBin(p[0], p[i+1], p[4], lo_[i][k], hi_[i][k]);
                if (!std::isfinite(e)) return 1.0e100;
                if (e < 1e-12) e = 1e-12;
                const double o = obs_[i][k];
                dev += (o > 0.0) ? 2.0*(e - o + o*std::log(o/e)) : 2.0*e;
            }
        }
        return dev;
    }
private:
    double norm_[3] = {0.0, 0.0, 0.0};
    std::vector<double> lo_[3], hi_[3], obs_[3];
};

// ============ Main ============
void epos_hbt_3D_robust() {

    gStyle->SetOptStat(0);
    gRandom->SetSeed(12345);
    TStopwatch sw;
    sw.Start();

    const double NaN = std::numeric_limits<double>::quiet_NaN();

    // ---- Collect ROOT files ----
    TString dir = gSystem->pwd();
    TString cmd = Form("ls %s/z-gg2my59a-*.root", dir.Data());
    TString filelist = gSystem->GetFromPipe(cmd);
    TObjArray* tokens = filelist.Tokenize("\n");

    vector<TString> filenames;
    for (int i = 0; i < tokens->GetEntries(); i++) {
        TString fn = tokens->At(i)->GetName();
        if (!fn.Contains(".root")) continue;
        if (fn.Contains("z-gg2my59a-261.root")) continue; // skip problematic file
        filenames.push_back(fn);
    }
    sort(filenames.begin(), filenames.end());
    cout << "Found " << filenames.size() << " ROOT files" << endl;

    // ---- Build TChain ----
    TChain* chain = new TChain("teposevent0");
    for (auto& fn : filenames) chain->Add(fn);

    int    np_ch = 0;
    const int MAXP = 200000;
    float  px[MAXP], py[MAXP], pz[MAXP], e_ch[MAXP];
    float  xr[MAXP], yr[MAXP], zr[MAXP], tr[MAXP];
    int    id_ch[MAXP], ist_ch[MAXP];

    chain->SetBranchAddress("np",  &np_ch);
    chain->SetBranchAddress("px",  px);
    chain->SetBranchAddress("py",  py);
    chain->SetBranchAddress("pz",  pz);
    chain->SetBranchAddress("e",   e_ch);
    chain->SetBranchAddress("x",   xr);
    chain->SetBranchAddress("y",   yr);
    chain->SetBranchAddress("z",   zr);
    chain->SetBranchAddress("t",   tr);
    chain->SetBranchAddress("id",  id_ch);
    chain->SetBranchAddress("ist", ist_ch);

    // ---- kT centers ----
    vector<double> kt_centers(nBins_kT);
    for (int i = 0; i < nBins_kT; i++)
        kt_centers[i] = kT_lo_edge + (i + 0.5) * kT_bin_width;

    // ---- D(rho) histograms per kT bin ----
    const int n_rho_bins = 300;
    double rho_min = 0.1, rho_max = 1e15;
    double rho_edges[n_rho_bins + 1];
    double r_factor = pow(rho_max / rho_min, 1.0 / n_rho_bins);
    rho_edges[0] = rho_min;
    for (int i = 1; i <= n_rho_bins; i++) rho_edges[i] = rho_edges[i-1] * r_factor;

    vector<TH1F*> hOut_all(nBins_kT), hSide_all(nBins_kT), hLong_all(nBins_kT);
    for (int i = 0; i < nBins_kT; i++) {
        hOut_all[i]  = new TH1F(Form("hOut_%d",i),  "", n_rho_bins, rho_edges);
        hSide_all[i] = new TH1F(Form("hSide_%d",i), "", n_rho_bins, rho_edges);
        hLong_all[i] = new TH1F(Form("hLong_%d",i), "", n_rho_bins, rho_edges);
        hOut_all[i]->Sumw2();
        hSide_all[i]->Sumw2();
        hLong_all[i]->Sumw2();
    }

    long long total_pairs_all = 0;
    vector<int> pair_count_per_bin(nBins_kT, 0);

    // ---- Event loop ----
    long long nEntries = chain->GetEntries();
    int nEvents = (int)nEntries;
    cout << "Processing " << nEntries << " events..." << endl;

    struct SimpleParticle {
        float px, py, pz, E;
        float x, y, z, t;
        int id;
    };

    for (long long ie = 0; ie < nEntries; ie++) {
        chain->GetEntry(ie);
        int npUse = min(np_ch, MAXP);

        vector<SimpleParticle> pions;

        for (int ip = 0; ip < npUse; ip++) {
            if (ist_ch[ip] != 0) continue;
            if (id_ch[ip] != 120 && id_ch[ip] != -120) continue;
            double pt  = sqrt(px[ip]*px[ip] + py[ip]*py[ip]);
            double pp  = sqrt(px[ip]*px[ip] + py[ip]*py[ip] + pz[ip]*pz[ip]);
            if (pt < pT_min || pt > pT_max) continue;
            double eta = 0.5 * log(fabs((pp + pz[ip]) / (pp - pz[ip])));
            if (fabs(eta) > eta_cut) continue;

            SimpleParticle sp;
            sp.px = px[ip]; sp.py = py[ip]; sp.pz = pz[ip];
            sp.E  = sqrt(pp*pp + m_pi*m_pi);   // the 'e' branch is not the energy in the epos out files
            sp.x  = xr[ip]; sp.y  = yr[ip]; sp.z  = zr[ip]; sp.t  = tr[ip];
            sp.id = id_ch[ip];
            pions.push_back(sp);
        }

        // Like-sign pairs
        for (size_t i = 0; i < pions.size(); i++) {
            const auto& p1 = pions[i];
            for (size_t j = i+1; j < pions.size(); j++) {
                const auto& p2 = pions[j];
                if (p1.id != p2.id) continue;

                double kx = 0.5*(p1.px + p2.px);
                double ky = 0.5*(p1.py + p2.py);
                double kz = 0.5*(p1.pz + p2.pz);
                double kT = sqrt(kx*kx + ky*ky);

                if (kT < kT_lo_edge || kT >= kT_hi_edge) continue;
                

                int ibin = (int)((kT - kT_lo_edge) / kT_bin_width);
                if (ibin < 0 || ibin >= nBins_kT) continue;

                double mT = sqrt(kT*kT + m_pi*m_pi);
                double qmCut = sqrt(0.2 * mT);

                double qx = p1.px - p2.px;
                double qy = p1.py - p2.py;
                double qzL = (4*pow((p1.pz*p2.E - p2.pz*p1.E),2)) /
                             (pow((p1.E+p2.E),2) - pow((p1.pz+p2.pz),2));
                double qLCMS = sqrt(qx*qx + qy*qy + qzL);
                if (qLCMS > qmCut) continue;
                
                double dx = p1.x - p2.x;
                double dy = p1.y - p2.y;
                double dz = p1.z - p2.z;
                double dt = p1.t - p2.t;

                double K0 = 0.5*(p1.E + p2.E);
                double kp = K0*K0 - kz*kz;
                double phi = atan2(ky, kx);
                
               if (!(kT > 0.0) || !std::isfinite(kT)) continue;

                if (!(kp > 0.0) || !std::isfinite(kp)) continue;


                double r_side = -sin(phi)*dx + cos(phi)*dy;
                double r_out  = cos(phi)*dx + sin(phi)*dy - (kT / kp) * (K0 * dt - kz * dz);
                double r_long = (K0*dz - kz*dt) / sqrt(kp);

               // double rho = sqrt(r_out*r_out + r_side*r_side + r_long*r_long);
                
                
                hOut_all[ibin]->Fill(fabs(r_out));
                hSide_all[ibin]->Fill(fabs(r_side));
                hLong_all[ibin]->Fill(fabs(r_long));
                pair_count_per_bin[ibin]++;
                total_pairs_all++;
            }
        }

        if ((ie+1) % 100 == 0)
            cout << "  " << (ie+1) << "/" << nEntries << " events processed" << endl;
    }

    cout << "\nTotal pairs: " << total_pairs_all << endl;
    for (int i = 0; i < nBins_kT; i++) {
        cout << "  kT=[" << kt_centers[i]-kT_bin_width/2 << "-"
             << kt_centers[i]+kT_bin_width/2 << "]: "
             << pair_count_per_bin[i] << " pairs" << endl;
    }

    // ---- Load Levy table ----
    myLevy_reader = new Levy_reader("levy_proj3D_values.dat");

    // ---- Storage (shape vectors are pushed together, ONLY for accepted 1mm fits) ----
    vector<double> mt_vals, mt_err_vals;
    vector<double> alpha_vals, alpha_err_vals;
    vector<double> Rout_vals, Rout_err_vals;
    vector<double> Rside_vals, Rside_err_vals;
    vector<double> Rlong_vals, Rlong_err_vals;
    vector<double> dev_vals, ndf_vals, fit_status_vals;

    map<string, vector<double>> lambda_by_cutoff;
    map<string, vector<double>> lambda_err_by_cutoff;
    for (auto& lc : rhoLambdaCutoffs) {
        lambda_by_cutoff[lc.first] = {};
        lambda_err_by_cutoff[lc.first] = {};
    }

    // ---- CSV file ----
    ofstream csvFile("EPOS_Levy_fit_parameters_cutoff.csv");
    if (!csvFile.is_open()) {
        cerr << "ERROR: Could not open EPOS_Levy_fit_parameters_cutoff.csv" << endl;
        return;
    }
    csvFile << "kT_low,kT_high,kT_center,mT,N_pairs,"
            << "alpha,alpha_err,Rout,Rout_err,Rside,Rside_err,Rlong,Rlong_err,";
    for (auto& lc : rhoLambdaCutoffs)
        csvFile << lc.first << "_lambda," << lc.first << "_lambda_err,";
    csvFile << "deviance,ndf,fit_status\n";

    // ---- Fit each kT bin ----
    cout << "\n=== FITTING D(rho) with Levy (cutoff loop) ===" << endl;

    // alpha, Rout, Rside, Rlong, lambda  (all strictly inside the limits)
    double startSets[][5] = {
        {1.2,  6.0, 4.0,  5.0, 0.85},
        {1.5,  8.0, 7.0, 11.0, 0.82},
        {1.4,  5.0, 4.0,  6.0, 0.90},
        {1.0, 10.0, 8.0, 12.0, 0.75},
        {1.8, 12.0, 6.0,  9.0, 1.00}
    };

    for (int ibin = 0; ibin < nBins_kT; ibin++) {
        double kT_lo = kT_lo_edge + ibin * kT_bin_width;
        double kT_hi = kT_lo + kT_bin_width;
        double kT_m  = kt_centers[ibin];
        double mT    = sqrt(kT_m*kT_m + m_pi*m_pi);

        if (pair_count_per_bin[ibin] < 100) {
            cout << "  kT=[" << kT_lo << "-" << kT_hi
                 << "] SKIPPED: only " << pair_count_per_bin[ibin] << " pairs" << endl;
            continue;
        }

        TH1F* hOutOrig  = hOut_all[ibin];
        TH1F* hSideOrig = hSide_all[ibin];
        TH1F* hLongOrig = hLong_all[ibin];

        bool baseParamsStored = false;
        double bestAlpha=0, bestAlphaErr=0, bestRout=0, bestRoutErr=0;
        double bestRside=0, bestRsideErr=0, bestRlong=0, bestRlongErr=0;
        double bestDev = -1, bestNdf = -1, bestStatus = -1;
        const double fit_min = 0.1;
        const double fit_max = sqrt(2500.0 / mT);

        for (auto& lc : rhoLambdaCutoffs) {
            const string& label = lc.first;
            const double rhoLamMax = lc.second;

            LogLikelihood loglikfunc(hOutOrig, hSideOrig, hLongOrig, fit_min, fit_max, rhoLamMax);
            const int actualBins = loglikfunc.nBins();
            if (actualBins < 30) {
                cout << "  kT=[" << kT_lo << "-" << kT_hi << "] " << label
                     << ": only " << actualBins << " fit bins, skip" << endl;
                if (!baseParamsStored) break;          // nothing pushed yet for this bin
                lambda_by_cutoff[label].push_back(NaN);
                lambda_err_by_cutoff[label].push_back(NaN);
                continue;
            }

            ROOT::Math::Functor f(loglikfunc, NPAR);

            bool fitConverged = false;
            double bestLocalDev = 1e30;
            double bestLocalPar[5] = {0,0,0,0,0};
            double bestLocalErr[5] = {0,0,0,0,0};
            double bestLocalStatus = -1;
            int    lastSt = -1;
            double lastEdm = -1;

            for (int iattempt = 0; iattempt < 5; iattempt++) {
                ROOT::Math::Minimizer* minimizer =
                    ROOT::Math::Factory::CreateMinimizer("Minuit2", "Migrad");
                minimizer->SetFunction(f);
                minimizer->SetMaxFunctionCalls(50000);
                minimizer->SetMaxIterations(50000);
                minimizer->SetTolerance(1e-4);
                minimizer->SetStrategy(2);
                minimizer->SetErrorDef(1.0);
                minimizer->SetPrintLevel(0);

                minimizer->SetLimitedVariable(0, "alpha",  startSets[iattempt][0], 0.01, 0.5, 2.5);
                minimizer->SetLimitedVariable(1, "Rout",   startSets[iattempt][1], 0.1,  2.0, 20.0);
                minimizer->SetLimitedVariable(2, "Rside",  startSets[iattempt][2], 0.1,  2.0, 20.0);
                minimizer->SetLimitedVariable(3, "Rlong",  startSets[iattempt][3], 0.1,  2.0, 20.0);
                minimizer->SetLimitedVariable(4, "lambda", startSets[iattempt][4], 0.01, 0.0, 1.2);

                minimizer->Minimize();
                const int st = minimizer->Status();
                lastSt  = st;
                lastEdm = minimizer->Edm();

                if (st == 0 || st == 1 || (st == 3 && lastEdm < 0.01)) {
                    minimizer->Hesse();
                    const double* px_ = minimizer->X();
                    const double* pe_ = minimizer->Errors();

                    // reject fits sitting on a limit or with unusable errors
                    bool ok = true;
                    for (int ip = 0; ip < 5; ip++)
                        if (!std::isfinite(px_[ip]) || !std::isfinite(pe_[ip]) || !(pe_[ip] > 0.0)) ok = false;
                    const bool atBoundary =
                        px_[1] > 19.9 || px_[2] > 19.9 || px_[3] > 19.9 ||
                        px_[1] < 2.01 || px_[2] < 2.01 || px_[3] < 2.01 ||
                        px_[0] < 0.51 || px_[0] > 2.49 ||
                        px_[4] < 0.001 || px_[4] > 1.199;

                    const double devval = minimizer->MinValue();
                    if (ok && !atBoundary && (!fitConverged || devval < bestLocalDev)) {
                        fitConverged = true;
                        bestLocalDev = devval;
                        bestLocalStatus = st;
                        for (int ip = 0; ip < 5; ip++) {
                            bestLocalPar[ip] = px_[ip];
                            bestLocalErr[ip] = pe_[ip];
                        }
                    }
                }
                delete minimizer;
            }

            // ---- Store results ----
            if (fitConverged) {
                lambda_by_cutoff[label].push_back(bestLocalPar[4]);
                lambda_err_by_cutoff[label].push_back(bestLocalErr[4]);

                if (!baseParamsStored) {          // first accepted fit = the 1mm reference
                    baseParamsStored = true;
                    bestAlpha = bestLocalPar[0]; bestAlphaErr = bestLocalErr[0];
                    bestRout  = bestLocalPar[1]; bestRoutErr  = bestLocalErr[1];
                    bestRside = bestLocalPar[2]; bestRsideErr = bestLocalErr[2];
                    bestRlong = bestLocalPar[3]; bestRlongErr = bestLocalErr[3];
                    bestDev = bestLocalDev;
                    bestNdf = actualBins - NPAR;
                    bestStatus = bestLocalStatus;

                    mt_vals.push_back(mT);          mt_err_vals.push_back(0.0);
                    alpha_vals.push_back(bestAlpha); alpha_err_vals.push_back(bestAlphaErr);
                    Rout_vals.push_back(bestRout);   Rout_err_vals.push_back(bestRoutErr);
                    Rside_vals.push_back(bestRside); Rside_err_vals.push_back(bestRsideErr);
                    Rlong_vals.push_back(bestRlong); Rlong_err_vals.push_back(bestRlongErr);
                    dev_vals.push_back(bestDev);
                    ndf_vals.push_back(bestNdf);
                    fit_status_vals.push_back(bestStatus);

                    cout << "  kT=[" << kT_lo << "-" << kT_hi << "] deviance/NDF = "
                         << bestDev << "/" << bestNdf << "   alpha=" << bestAlpha
                         << " Rout=" << bestRout << " Rside=" << bestRside
                         << " Rlong=" << bestRlong << endl;
                }

                cout << "  kT=[" << kT_lo << "-" << kT_hi << "] " << label
                     << " lambda = " << bestLocalPar[4] << " +/- " << bestLocalErr[4] << endl;
            } else {
                cout << "  kT=[" << kT_lo << "-" << kT_hi << "] " << label
                     << " fit rejected (last Minuit status " << lastSt
                     << ", EDM " << lastEdm << ")" << endl;

                // A failed 1mm fit means nothing was pushed for this bin: leave it out entirely,
                // so every vector stays aligned with mt_vals.
                if (!baseParamsStored) break;

                lambda_by_cutoff[label].push_back(NaN);
                lambda_err_by_cutoff[label].push_back(NaN);
            }
        } // end cutoff loop

        // ---- CSV row ----
        if (baseParamsStored) {
            csvFile << fixed << setprecision(8)
                    << kT_lo << "," << kT_hi << "," << kT_m << "," << mT << ","
                    << pair_count_per_bin[ibin] << ","
                    << bestAlpha << "," << bestAlphaErr << ","
                    << bestRout  << "," << bestRoutErr  << ","
                    << bestRside << "," << bestRsideErr << ","
                    << bestRlong << "," << bestRlongErr << ",";
            for (auto& lc : rhoLambdaCutoffs) {
                csvFile << lambda_by_cutoff[lc.first].back() << ","
                        << lambda_err_by_cutoff[lc.first].back() << ",";
            }
            csvFile << bestDev << "," << bestNdf << "," << bestStatus << "\n";
            csvFile.flush();
        }
    } // end kT bin loop

    csvFile.close();
    cout << "\nSaved fitted parameters to: EPOS_Levy_fit_parameters_cutoff.csv" << endl;

    // ============================================================
    // Draw D(rho) per kT bin (1mm cutoff fit)
    // ============================================================
    int nPoints = (int)mt_vals.size();
    if (nPoints > 0) {
        for (int ibin = 0; ibin < nBins_kT; ibin++) {
            if (pair_count_per_bin[ibin] < 100) continue;
            double kT_lo = kT_lo_edge + ibin * kT_bin_width;
            double kT_hi = kT_lo + kT_bin_width;
            double kT_m  = kt_centers[ibin];
            double mT    = sqrt(kT_m*kT_m + m_pi*m_pi);

            int idx = -1;
            for (size_t j = 0; j < mt_vals.size(); j++) {
                if (fabs(mt_vals[j] - mT) < 1e-9) { idx = (int)j; break; }
            }
            if (idx < 0) continue;

            double fit_max_disp = sqrt(2500.0 / mT);

            TCanvas* cSample = new TCanvas(
                Form("cDrho_kT%d", ibin),
                Form("D(rho) with fit, kT=%.2f-%.2f GeV/c", kT_lo, kT_hi),
                1800, 600);
            cSample->Divide(3, 1);

            TH1F* hists[3] = {hOut_all[ibin], hSide_all[ibin], hLong_all[ibin]};
            double Rvals[3] = {Rout_vals[idx], Rside_vals[idx], Rlong_vals[idx]};
            string dirNames[3] = {"out", "side", "long"};

            for (int idir = 0; idir < 3; idir++) {
                cSample->cd(idir + 1);
                gPad->SetLogx();
                gPad->SetLogy();
                gPad->SetLeftMargin(0.15);

                TH1F* h = (TH1F*)hists[idir]->Clone();
                h->SetDirectory(0);

                // normalise to the full source up to rho_max^lambda(1mm), as in the fit
                const double rhoLam1mm = rhoLambdaCutoffs[0].second;
                int lastLambdaBin = h->FindBin(rhoLam1mm);
                if (lastLambdaBin > h->GetNbinsX()) lastLambdaBin = h->GetNbinsX();
                double normalizationCount = h->Integral(0.0, lastLambdaBin);
                if (normalizationCount > 0.0) h->Scale(1.0 / normalizationCount, "width");

                h->SetMinimum(1e-25);
                h->SetMaximum(1e0);
                h->GetXaxis()->SetRangeUser(0.1, 1e15);
                h->SetLineColor(kBlack);
                h->SetLineWidth(1);
                h->SetMarkerStyle(20);
                h->SetMarkerSize(0.4);
                h->SetMarkerColor(kBlack);
                h->SetTitle(Form("D(#rho);#rho_{%s} [fm];D(#rho)", dirNames[idir].c_str()));
                h->Draw("E1");

                double pars[3] = {alpha_vals[idx], Rvals[idir], lambda_by_cutoff["1mm"][idx]};

                // solid: fitted core range; dashed: extrapolation to the pad edge
                TF1* fCore = new TF1(Form("fcore_%s_kT%d", dirNames[idir].c_str(), ibin),
                                     LevyProj1DFunc, 0.1, fit_max_disp, 3);
                fCore->SetParameters(pars);
                fCore->SetNpx(1000);
                fCore->SetLineColor(kRed);
                fCore->SetLineWidth(3);
                fCore->Draw("SAME");

                TF1* fTail = new TF1(Form("ftail_%s_kT%d", dirNames[idir].c_str(), ibin),
                                     LevyProj1DFunc, fit_max_disp, 1e15, 3);
                fTail->SetParameters(pars);
                fTail->SetNpx(1000);
                fTail->SetLineColor(kRed);
                fTail->SetLineStyle(2);
                fTail->SetLineWidth(3);
                fTail->Draw("SAME");

                TLine* lFitMax = new TLine(fit_max_disp, 1e-25, fit_max_disp, 1e0);
                lFitMax->SetLineColor(kGray + 2);
                lFitMax->SetLineStyle(7);
                lFitMax->Draw("SAME");
            }

            cSample->cd(3);
            TPaveText* infoS = new TPaveText(0.55, 0.55, 0.89, 0.89, "NDC");
            infoS->SetBorderSize(0);
            infoS->SetFillStyle(0);
            infoS->SetTextSize(0.035);
            infoS->AddText(Form("#alpha = %.3f #pm %.3f", alpha_vals[idx], alpha_err_vals[idx]));
            infoS->AddText(Form("R_{out} = %.2f #pm %.2f fm", Rout_vals[idx], Rout_err_vals[idx]));
            infoS->AddText(Form("R_{side} = %.2f #pm %.2f fm", Rside_vals[idx], Rside_err_vals[idx]));
            infoS->AddText(Form("R_{long} = %.2f #pm %.2f fm", Rlong_vals[idx], Rlong_err_vals[idx]));
            infoS->AddText(Form("#lambda = %.3f #pm %.3f",
                                lambda_by_cutoff["1mm"][idx], lambda_err_by_cutoff["1mm"][idx]));
            infoS->AddText(Form("deviance/NDF: %.1f/%.0f", dev_vals[idx], ndf_vals[idx]));
            infoS->Draw();

            cSample->cd(1);
            TPaveText* infoSys = new TPaveText(0.55, 0.55, 0.89, 0.89, "NDC");
            infoSys->SetBorderSize(0);
            infoSys->SetFillStyle(0);
            infoSys->SetTextSize(0.035);
            infoSys->AddText(Form("kT: %.2f - %.2f GeV/c", kT_lo, kT_hi));
            infoSys->AddText(Form("#rho_{fit}^{max} = %.1f fm", fit_max_disp));
            infoSys->AddText(Form("N_{events} = %d", nEvents));
            infoSys->AddText(Form("N_{pairs} = %d", pair_count_per_bin[ibin]));
            infoSys->Draw();

            cSample->SaveAs(Form("EPOS_Drho_kT%.2f_%.2f_cutoff.png", kT_lo, kT_hi));
            delete cSample;
        }
        cout << "\nSaved D(rho) canvases" << endl;
    }

    // ============================================================
    // mT vs fit parameters (4-pad)
    // ============================================================
    int nPoints2 = (int)mt_vals.size();
    if (nPoints2 >= 2) {
        TCanvas* c_mT = new TCanvas("c_mT", "Fit Parameters vs m_T", 1600, 1200);
        c_mT->Divide(2, 2);

        vector<double> mt_e(nPoints2, 0.0);

        c_mT->cd(1);
        TGraphErrors* gAlpha = new TGraphErrors(nPoints2,
            &mt_vals[0], &alpha_vals[0], &mt_e[0], &alpha_err_vals[0]);
        gAlpha->SetTitle("#alpha vs m_{T}; m_{T} [GeV/c^{2}]; #alpha");
        gAlpha->SetMarkerStyle(20);
        gAlpha->SetMarkerColor(kBlack);
        gAlpha->GetHistogram()->GetYaxis()->SetRangeUser(1.4, 1.9);
        gAlpha->Draw("APE");

        c_mT->cd(2);
        TGraphErrors* gRout = new TGraphErrors(nPoints2,
            &mt_vals[0], &Rout_vals[0], &mt_e[0], &Rout_err_vals[0]);
        gRout->SetMarkerStyle(21); gRout->SetMarkerColor(kRed);
        gRout->SetLineColor(kRed);
        gRout->SetTitle("HBT radii vs m_{T}; m_{T} [GeV/c^{2}]; R [fm]");

        TGraphErrors* gRside = new TGraphErrors(nPoints2,
            &mt_vals[0], &Rside_vals[0], &mt_e[0], &Rside_err_vals[0]);
        gRside->SetMarkerStyle(22); gRside->SetMarkerColor(kBlue);
        gRside->SetLineColor(kBlue);

        TGraphErrors* gRlong =
        new TGraphErrors(nPoints2,
            &mt_vals[0], &Rlong_vals[0], &mt_e[0], &Rlong_err_vals[0]);
        gRlong->SetMarkerStyle(23); gRlong->SetMarkerColor(kGreen+2);
        gRlong->SetLineColor(kGreen+2);

        gRout->GetHistogram()->GetYaxis()->SetRangeUser(3.0, 15.0);
        gRout->Draw("APE");
        gRside->Draw("P SAME");
        gRlong->Draw("P SAME");

        TLegend* legR = new TLegend(0.65, 0.70, 0.88, 0.88);
        legR->SetBorderSize(0); legR->SetFillStyle(0);
        legR->AddEntry(gRout,  "R_{out}",  "P");
        legR->AddEntry(gRside, "R_{side}", "P");
        legR->AddEntry(gRlong, "R_{long}", "P");
        legR->Draw();

        c_mT->cd(3);
        const auto& lam1mm    = lambda_by_cutoff["1mm"];
        const auto& lam1mmErr = lambda_err_by_cutoff["1mm"];
        if ((int)lam1mm.size() == nPoints2) {
            TGraphErrors* gLambda = new TGraphErrors(nPoints2,
                &mt_vals[0], &lam1mm[0], &mt_e[0], &lam1mmErr[0]);
            gLambda->SetTitle("#lambda_{1mm} vs m_{T}; m_{T} [GeV/c^{2}]; #lambda");
            gLambda->SetMarkerStyle(20); gLambda->SetMarkerColor(kBlack);
            gLambda->Draw("APE");
        } else {
            TPaveText* warn = new TPaveText(0.15, 0.45, 0.85, 0.60, "NDC");
            warn->SetBorderSize(0); warn->SetFillStyle(0);
            warn->AddText("Incomplete #lambda results for 1mm");
            warn->Draw();
        }

        c_mT->cd(4);
        gPad->SetFillColor(0); gPad->SetFrameBorderMode(0);
        TPaveText* sysInfo = new TPaveText(0.10, 0.10, 0.90, 0.90, "NDC");
        sysInfo->SetTextSize(0.045); sysInfo->SetFillColor(0);
        sysInfo->SetBorderSize(1); sysInfo->SetTextFont(42); sysInfo->SetTextAlign(12);
        sysInfo->AddText("System Information");
        sysInfo->AddText("---------------------------");
        sysInfo->AddText("EPOS Au+Au 0-5%");
        sysInfo->AddText("#sqrt{s_{NN}} = 200 GeV");
        sysInfo->AddText(" ");
        sysInfo->AddText(Form("N_{events} = %d", nEvents));
        sysInfo->AddText(Form("Total pairs: %lld", total_pairs_all));
        sysInfo->AddText(Form("kT bins with fits: %d / %d", nPoints2, nBins_kT));
        sysInfo->AddText(" ");
        sysInfo->AddText("Kinematic cuts:");
        sysInfo->AddText(Form("%.2f < p_{T} < %.2f GeV/c", pT_min, pT_max));
        sysInfo->AddText(Form("|#eta| < %.1f", eta_cut));
        sysInfo->AddText(" ");
        sysInfo->AddText("EPOS ID: #pi^{+} = 120, #pi^{-} = -120");
        sysInfo->AddText("ist = 0 (final state)");
        sysInfo->Draw();

        c_mT->SaveAs("EPOS_mT_params_cutoff.png");
        cout << "\nSaved: EPOS_mT_params_cutoff.png" << endl;
    }

    sw.Stop();
    sw.Print();
}
