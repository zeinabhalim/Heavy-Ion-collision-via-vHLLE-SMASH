using namespace std;

// ============ Configuration ============
const double m_pi = 0.13957;
const double pT_min  = 0.15;
const double pT_max  = 1.0;
const double eta_cut = 1.0;
const int    NPAR    = 5;

// kT bins
const double kT_bin_width = 0.05;
const double kT_lo_edge   = 0.15;
const double kT_hi_edge   = 0.85;
const int    nBins_kT = (int)((kT_hi_edge - kT_lo_edge) / kT_bin_width);

// Cutoff labels retained for the lambda CSV; fit normalisation follows the first code
vector<pair<string, double>> rhoLambdaCutoffs = {
    {"1mm",   1.0e12},
    {"5mm",   5.0e12},
    {"5cm",   5.0e13},
    {"50cm",  5.0e14}
};

// Levy projection reader
Levy_reader* myLevy_reader;

double LevyProj1DFunc(const double *x, const double *par) {
    double alpha = par[0];
    double R     = par[1];
    double N     = par[2];
    double Rcc   = R * pow(2., 1./alpha);
    return (2.*N / Rcc) * myLevy_reader->getValue_1d(alpha, x[0]/Rcc);
}

// ============ LogLikelihood (same normalisation convention as the first code) ============
class LogLikelihood {
public:
    LogLikelihood(TH1F* hOut, TH1F* hSide, TH1F* hLong,
                  double xmin, double xmax, int* binsUsed)
    : hOut_(hOut), hSide_(hSide), hLong_(hLong),
      xMin(xmin), xMax(xmax), nBinsUsed(binsUsed) {
        *nBinsUsed = 0;
        for (int idir=0; idir<3; ++idir) {
            TH1F* h = (idir==0) ? hOut_ : (idir==1) ? hSide_ : hLong_;
            for (int i=1; i<=h->GetNbinsX(); ++i) {
                double xc = h->GetBinCenter(i);
                if (xc >= xMin && xc <= xMax && h->GetBinContent(i) > 0)
                    (*nBinsUsed)++;
            }
        }
    }

    double operator()(const double* par) const {
        double alpha = par[0];
        double Rout  = par[1];
        double Rside = par[2];
        double Rlong = par[3];
        double N     = par[4];

        double logL = 0;
        TH1F* hists[3] = {hOut_, hSide_, hLong_};
        double Rvals[3] = {Rout, Rside, Rlong};

        for (int idir=0; idir<3; ++idir) {
            TH1F* h = hists[idir];
            double R = Rvals[idir];

            // The histogram is already normalised over [xMin, xMax].
            // Do NOT renormalise it again here.
            for (int i=1; i<=h->GetNbinsX(); ++i) {
                double xc = h->GetBinCenter(i);
                if (xc < xMin || xc > xMax) continue;
                double data = h->GetBinContent(i);

                double pars[3] = {alpha, R, N};
                double model = LevyProj1DFunc(&xc, pars);
                if (model < 1e-30) model = 1e-30;

                // Fix: include empty bins in the Poisson deviance so the
                // upper tail constrains the fit (do not skip them).
                if (data > 0.0) {
                    logL += data * log(model / data) + (data - model);
                } else {
                    logL += 2.0 * model;
                }
            }
        }
        return -2.0 * logL;
    }


private:
    TH1F *hOut_, *hSide_, *hLong_;
    double xMin, xMax;
    int* nBinsUsed;
};

// ============ Main ============
void epos_hbt_3D_robust() {

    gRandom->SetSeed(12345);
    TStopwatch sw;
    sw.Start();

    // ---- Collect ROOT files ----
    TString dir = gSystem->pwd();
    TString cmd = Form("ls %s/z-gg2my59a-*.root", dir.Data());
    TString filelist = gSystem->GetFromPipe(cmd);
    TObjArray* tokens = filelist.Tokenize("\n");

    vector<TString> filenames;
    for (int i = 0; i < tokens->GetEntries(); i++) {
        TString fn = tokens->At(i)->GetName();
        if (!fn.Contains(".root")) continue;
        if (fn.Contains("z-gg2my59a-261.root")) continue; // skip problematic file
        filenames.push_back(fn);
    }
    sort(filenames.begin(), filenames.end());
    cout << "Found " << filenames.size() << " ROOT files" << endl;

    // ---- Build TChain ----
    TChain* chain = new TChain("teposevent0");
    for (auto& fn : filenames) chain->Add(fn);

    int    np_ch = 0;
    const int MAXP = 200000;
    float  px[MAXP], py[MAXP], pz[MAXP], e_ch[MAXP];
    float  xr[MAXP], yr[MAXP], zr[MAXP], tr[MAXP];
    int    id_ch[MAXP], ist_ch[MAXP];

    chain->SetBranchAddress("np",  &np_ch);
    chain->SetBranchAddress("px",  px);
    chain->SetBranchAddress("py",  py);
    chain->SetBranchAddress("pz",  pz);
    chain->SetBranchAddress("e",   e_ch);
    chain->SetBranchAddress("x",   xr);
    chain->SetBranchAddress("y",   yr);
    chain->SetBranchAddress("z",   zr);
    chain->SetBranchAddress("t",   tr);
    chain->SetBranchAddress("id",  id_ch);
    chain->SetBranchAddress("ist", ist_ch);

    // ---- kT centers ----
    vector<double> kt_centers(nBins_kT);
    for (int i = 0; i < nBins_kT; i++)
        kt_centers[i] = kT_lo_edge + (i + 0.5) * kT_bin_width;

    // ---- D(rho) histograms per kT bin ----
    const int n_rho_bins = 300;
    double rho_min = 0.1, rho_max = 1e15;
    double rho_edges[n_rho_bins + 1];
    double r_factor = pow(rho_max / rho_min, 1.0 / n_rho_bins);
    rho_edges[0] = rho_min;
    for (int i = 1; i <= n_rho_bins; i++) rho_edges[i] = rho_edges[i-1] * r_factor;

    vector<TH1F*> hOut_all(nBins_kT), hSide_all(nBins_kT), hLong_all(nBins_kT);
    for (int i = 0; i < nBins_kT; i++) {
        hOut_all[i]  = new TH1F(Form("hOut_%d",i),  "", n_rho_bins, rho_edges);
        hSide_all[i] = new TH1F(Form("hSide_%d",i), "", n_rho_bins, rho_edges);
        hLong_all[i] = new TH1F(Form("hLong_%d",i), "", n_rho_bins, rho_edges);
        hOut_all[i]->Sumw2();
        hSide_all[i]->Sumw2();
        hLong_all[i]->Sumw2();
    }

    long long total_pairs_all = 0;
    int pair_count_per_bin[nBins_kT];
    for (int i = 0; i < nBins_kT; i++) pair_count_per_bin[i] = 0;

    // ---- Event loop ----
    long long nEntries = chain->GetEntries();
    int nEvents = (int)nEntries;
    cout << "Processing " << nEntries << " events..." << endl;

    for (long long ie = 0; ie < nEntries; ie++) {
        chain->GetEntry(ie);
        int npUse = min(np_ch, MAXP);

        struct SimpleParticle {
            float px, py, pz, E;
            float x, y, z, t;
            int id;
        };
        vector<SimpleParticle> pions;

        for (int ip = 0; ip < npUse; ip++) {
            if (ist_ch[ip] != 0) continue;
            if (id_ch[ip] != 120 && id_ch[ip] != -120) continue;
            double pt  = sqrt(px[ip]*px[ip] + py[ip]*py[ip]);
            double pp  = sqrt(px[ip]*px[ip] + py[ip]*py[ip] + pz[ip]*pz[ip]);
            double eta = 0.5 * log((pp + pz[ip]) / (pp - pz[ip]));
            if (pt < pT_min || pt > pT_max) continue;
            if (fabs(eta) > eta_cut) continue;

            SimpleParticle sp;
            sp.px = px[ip]; sp.py = py[ip]; sp.pz = pz[ip]; sp.E = e_ch[ip];
            sp.x  = xr[ip]; sp.y  = yr[ip]; sp.z  = zr[ip]; sp.t  = tr[ip];
            sp.id = id_ch[ip];
            pions.push_back(sp);
        }

        // Like-sign pairs
        for (size_t i = 0; i < pions.size(); i++) {
            const auto& p1 = pions[i];
            for (size_t j = i+1; j < pions.size(); j++) {
                const auto& p2 = pions[j];
                if (p1.id != p2.id) continue;

                double kx = 0.5*(p1.px + p2.px);
                double ky = 0.5*(p1.py + p2.py);
                double kz = 0.5*(p1.pz + p2.pz);
                double kT = sqrt(kx*kx + ky*ky);

                int ibin = (int)((kT - kT_lo_edge) / kT_bin_width);
                if (ibin < 0 || ibin >= nBins_kT) continue;

                double mT = sqrt(kT*kT + m_pi*m_pi);
                double qmCut = sqrt(0.2 * mT);

                double qx = p1.px - p2.px;
                double qy = p1.py - p2.py;
                double qzL = (4*pow((p1.pz*p2.E - p2.pz*p1.E),2)) /
                             (pow((p1.E+p2.E),2) - pow((p1.pz+p2.pz),2));
                double qLCMS = sqrt(qx*qx + qy*qy + qzL);
                if (qLCMS > qmCut) continue;

                double dx = p1.x - p2.x;
                double dy = p1.y - p2.y;
                double dz = p1.z - p2.z;
                double dt = p1.t - p2.t;

                double K0 = 0.5*(p1.E + p2.E);
                double kp = K0*K0 - kz*kz;
                double phi = atan2(ky, kx);

                if (!(kp > 0.0) ||
                    !std::isfinite(kp)) {
                    continue;
                }

                if (!(kT > 0.0) ||
                    !std::isfinite(kT)) {
                    continue;
                }
                double r_side = -sin(phi)*dx + cos(phi)*dy;

                double r_out  = cos(phi)*dx + sin(phi)*dy - (kT / kp)
                      * (K0 * dt - kz * dz);
                double r_long = (K0*dz - kz*dt) / sqrt(kp);
                // rout including the time boost
                //double r_out  = cos(phi)*dx + sin(phi)*dy - (kT/kp) * (K0*dt - kz*dz);

                double rho = sqrt(r_out*r_out + r_side*r_side + r_long*r_long);

                hOut_all[ibin]->Fill(fabs(r_out));
                hSide_all[ibin]->Fill(fabs(r_side));
                hLong_all[ibin]->Fill(fabs(r_long));
                pair_count_per_bin[ibin]++;
                total_pairs_all++;
            }
        }

        if ((ie+1) % 100 == 0)
            cout << "  " << (ie+1) << "/" << nEntries << " events processed" << endl;
    }

    cout << "\nTotal pairs: " << total_pairs_all << endl;
    for (int i = 0; i < nBins_kT; i++) {
        cout << "  kT=[" << kt_centers[i]-kT_bin_width/2 << "-"
             << kt_centers[i]+kT_bin_width/2 << "]: "
             << pair_count_per_bin[i] << " pairs" << endl;
    }

    // ---- Load Levy table ----
    myLevy_reader = new Levy_reader("levy_proj3D_values.dat");
    // ---- Storage for results ----
    // Per kT bin, we store the base parameters (alpha, R's) only once (using a reference cutoff, e.g., 1mm)
    vector<double> mt_vals, mt_err_vals;
    vector<double> alpha_vals, alpha_err_vals;
    vector<double> Rout_vals, Rout_err_vals;
    vector<double> Rside_vals, Rside_err_vals;
    vector<double> Rlong_vals, Rlong_err_vals;
    vector<double> logL_vals, ndf_vals, fit_status_vals;

    // Lambda per cutoff: map cutoff_label -> vector of lambda values (one per kT bin)
    map<string, vector<double>> lambda_by_cutoff;
    map<string, vector<double>> lambda_err_by_cutoff;
    // No need to pre‑initialize; operator[] will create empty vectors when first used.
    for (auto& lc : rhoLambdaCutoffs) {
        lambda_by_cutoff[lc.first] = {};
        lambda_err_by_cutoff[lc.first] = {};
    }

    // ---- CSV file ----
    ofstream csvFile("EPOS_Levy_fit_parameters_cutoff.csv");
    if (!csvFile.is_open()) {
        cerr << "ERROR: Could not open EPOS_Levy_fit_parameters_cutoff.csv" << endl;
        return;
    }

    // CSV header
    csvFile << "kT_low,kT_high,kT_center,mT,N_pairs,"
            << "alpha,alpha_err,"
            << "Rout,Rout_err,"
            << "Rside,Rside_err,"
            << "Rlong,Rlong_err,";
    for (auto& lc : rhoLambdaCutoffs) {
        csvFile << lc.first << "_lambda," << lc.first << "_lambda_err,";
    }
    csvFile << "chi2,ndf,fit_status\n";

    // ---- Fit each kT bin ----
    cout << "\n=== FITTING D(rho) with Lévy (cutoff loop) ===" << endl;

    double startSets[][5] = {
        {1.0,  8.0, 3.0, 4.0, 1.0},
        {1.3, 10.0, 2.5, 3.5, 0.8},
        {1.6, 15.0, 4.0, 5.0, 1.2},
        {1.9, 20.0, 3.5, 6.0, 0.6},
        {2.2, 12.0, 2.0, 3.0, 1.4}
    };

    for (int ibin = 0; ibin < nBins_kT; ibin++) {
        double kT_lo = kT_lo_edge + ibin * kT_bin_width;
        double kT_hi = kT_lo + kT_bin_width;
        double kT_m  = kt_centers[ibin];
        double mT    = sqrt(kT_m*kT_m + m_pi*m_pi);

        if (pair_count_per_bin[ibin] < 100) {
            cout << "  kT=[" << kT_lo << "-" << kT_hi
                 << "] SKIPPED: only " << pair_count_per_bin[ibin] << " pairs" << endl;
            continue;
        }

        // ---- Prepare histograms (will be cloned for each cutoff) ----
        TH1F* hOutOrig = hOut_all[ibin];
        TH1F* hSideOrig = hSide_all[ibin];
        TH1F* hLongOrig = hLong_all[ibin];

        // For this bin, we will store the best parameters from the first cutoff (1mm)
        bool baseParamsStored = false;
        double bestAlpha, bestAlphaErr, bestRout, bestRoutErr, bestRside, bestRsideErr, bestRlong, bestRlongErr;
        double bestChi2 = -1, bestNdf = -1, bestStatus = -1;
        double fit_min = 0.1;
        double fit_max = sqrt(2500.0 / mT);

        // ---- Loop over cutoff labels ----
        // Cutoff labels are retained for the CSV/output structure, but the
        // FIT NORMALISATION is now exactly the same as in the first code:
        // each histogram is normalised over [fit_min, fit_max].
        // Therefore changing rhoLamMax does not change the fitted parameters.
        for (auto& lc : rhoLambdaCutoffs) {
            const string& label = lc.first;
            const double rhoLamMax = lc.second; 

            // Clone and normalise each direction histogram over the FIT RANGE ONLY.
            TH1F* hOutNorm = (TH1F*)hOutOrig->Clone();
            TH1F* hSideNorm = (TH1F*)hSideOrig->Clone();
            TH1F* hLongNorm = (TH1F*)hLongOrig->Clone();
            hOutNorm->SetDirectory(0);
            hSideNorm->SetDirectory(0);
            hLongNorm->SetDirectory(0);

            int binLowOut   = hOutNorm->FindBin(fit_min);
            int binHighOut  = hOutNorm->FindBin(fit_max);
            int binLowSide  = hSideNorm->FindBin(fit_min);
            int binHighSide = hSideNorm->FindBin(fit_max);
            int binLowLong  = hLongNorm->FindBin(fit_min);
            int binHighLong = hLongNorm->FindBin(fit_max);

            double integralOut = hOutNorm->Integral(binLowOut, binHighOut, "width");
            double integralSide = hSideNorm->Integral(binLowSide, binHighSide, "width");
            double integralLong = hLongNorm->Integral(binLowLong, binHighLong, "width");

            if (integralOut > 0) hOutNorm->Scale(1.0 / integralOut, "width");
            if (integralSide > 0) hSideNorm->Scale(1.0 / integralSide, "width");
            if (integralLong > 0) hLongNorm->Scale(1.0 / integralLong, "width");

            // The histograms are already normalised above; LogLikelihood
            // must use their bin contents directly (no second normalisation).
            int actualBins = 0;
            LogLikelihood loglikfunc(hOutNorm, hSideNorm, hLongNorm,
                                     fit_min, fit_max, &actualBins);
            if (actualBins < 30) {
                cout << "  kT=[" << kT_lo << "-" << kT_hi
                     << "] cutoff " << label << ": only " << actualBins << " bins with data, skip" << endl;
                delete hOutNorm; delete hSideNorm; delete hLongNorm;
                continue;
            }

            ROOT::Math::Functor f(loglikfunc, NPAR);

            // ---- Multiple starting points ----
            bool fitConverged = false;
            double bestLocalChi2 = 1e30;
            double bestLocalPar[5] = {0,0,0,0,0};
            double bestLocalErr[5] = {0,0,0,0,0};
            double bestLocalStatus = -1; // Fix: capture the real Minuit status

            for (int iattempt = 0; iattempt < 5; iattempt++) {
                ROOT::Math::Minimizer* minimizer =
                    ROOT::Math::Factory::CreateMinimizer("Minuit2", "Migrad");
                minimizer->SetFunction(f);
                minimizer->SetMaxFunctionCalls(50000);
                minimizer->SetMaxIterations(50000);
                minimizer->SetTolerance(1e-4);
                minimizer->SetStrategy(2);
                minimizer->SetPrintLevel(-1);

                minimizer->SetLimitedVariable(0, "alpha", startSets[iattempt][0], 0.1, 0.5, 2.5);

                minimizer->SetLimitedVariable(1, "Rout",  startSets[iattempt][1], 0.1, 0.5, 30.0);
                minimizer->SetLimitedVariable(2, "Rside", startSets[iattempt][2], 0.1, 0.5, 30.0);
                minimizer->SetLimitedVariable(3, "Rlong", startSets[iattempt][3], 0.1, 0.5, 20.0);

                minimizer->SetLimitedVariable(4, "N",     startSets[iattempt][4], 0.01, 0.0, 1.0);

                minimizer->Minimize();

                if (minimizer->Status() == 0) {
                    // Fix: call Hesse() to get proper Hessian-based errors
                    minimizer->Hesse();
                    double chi2val = minimizer->MinValue();
                    if (!fitConverged || chi2val < bestLocalChi2) {
                        fitConverged = true;
                        bestLocalChi2 = chi2val;
                        bestLocalStatus = minimizer->Status();
                        const double* px = minimizer->X();
                        const double* pe = minimizer->Errors();
                        for (int ip = 0; ip < 5; ip++) {
                            bestLocalPar[ip] = px[ip];
                            bestLocalErr[ip] = pe[ip];
                        }
                    }
                }
                delete minimizer;
            }

            // ---- Store results ----
            if (fitConverged) {
                // Store lambda for this cutoff
                lambda_by_cutoff[label].push_back(bestLocalPar[4]);
                lambda_err_by_cutoff[label].push_back(bestLocalErr[4]);

                // Store base parameters from the first cutoff iteration (all iterations use the same fit normalisation)
                if (!baseParamsStored) {
                    baseParamsStored = true;
                    bestAlpha = bestLocalPar[0];
                    bestAlphaErr = bestLocalErr[0];
                    bestRout = bestLocalPar[1];
                    bestRoutErr = bestLocalErr[1];
                    bestRside = bestLocalPar[2];
                    bestRsideErr = bestLocalErr[2];
                    bestRlong = bestLocalPar[3];
                    bestRlongErr = bestLocalErr[3];
                    bestChi2 = bestLocalChi2;
                    
                    bestNdf = actualBins - NPAR;
                    // Fix: store the real status instead of the hardcoded 1
                    bestStatus = bestLocalStatus;

                    // Store in global vectors (for mT plots)
                    mt_vals.push_back(mT);
                    mt_err_vals.push_back(0.0);
                    alpha_vals.push_back(bestAlpha);
                    alpha_err_vals.push_back(bestAlphaErr);
                    Rout_vals.push_back(bestRout);
                    Rout_err_vals.push_back(bestRoutErr);
                    Rside_vals.push_back(bestRside);
                    Rside_err_vals.push_back(bestRsideErr);
                    Rlong_vals.push_back(bestRlong);
                    Rlong_err_vals.push_back(bestRlongErr);
                    logL_vals.push_back(bestChi2);
                    ndf_vals.push_back(bestNdf);
                    fit_status_vals.push_back(bestStatus);
                }

                cout << "  kT=[" << kT_lo << "-" << kT_hi << "] " << label
                     << " λ = " << bestLocalPar[4] << " +/- " << bestLocalErr[4] << endl;
            } else {
                cout << "  kT=[" << kT_lo << "-" << kT_hi << "] " << label
                     << " fit did not converge" << endl;

                // Fix: store NaN placeholders (already present, kept identical)
                const double NaN =
                    std::numeric_limits<double>::quiet_NaN();

                lambda_by_cutoff[label].push_back(NaN);
                lambda_err_by_cutoff[label].push_back(NaN);
            }

            delete hOutNorm;
            delete hSideNorm;
            delete hLongNorm;
        } // end cutoff loop

        // ---- Write CSV row for this kT bin ----
        if (baseParamsStored) {
            csvFile << fixed << setprecision(8)
                    << kT_lo << ","
                    << kT_hi << ","
                    << kT_m << ","
                    << mT << ","
                    << pair_count_per_bin[ibin] << ","
                    << bestAlpha << "," << bestAlphaErr << ","
                    << bestRout << "," << bestRoutErr << ","
                    << bestRside << "," << bestRsideErr << ","
                    << bestRlong << "," << bestRlongErr << ",";

            // Lambda values for each cutoff (must be in same order as rhoLambdaCutoffs)
            for (auto& lc : rhoLambdaCutoffs) {
                const string& label = lc.first;
                double lam = lambda_by_cutoff[label].back();
                double lamErr = lambda_err_by_cutoff[label].back();
                csvFile << lam << "," << lamErr << ",";
            }
            csvFile << bestChi2 << "," << bestNdf << "," << bestStatus << "\n";
            csvFile.flush();
        }
    } // end kT bin loop

    csvFile.close();
    cout << "\nSaved fitted parameters to: EPOS_Levy_fit_parameters_cutoff.csv" << endl;

    // ============================================================
    // Draw D(rho) per kT bin (using 1mm cutoff fit for display)
    // ============================================================
    int nPoints = mt_vals.size();
    if (nPoints > 0) {
        // For drawing we need to match the stored base parameters (index j) with the kT bin.
        // We'll just loop over bins and find the matching mT.
        for (int ibin = 0; ibin < nBins_kT; ibin++) {
            if (pair_count_per_bin[ibin] < 100) continue;
            double kT_lo = kT_lo_edge + ibin * kT_bin_width;
            double kT_hi = kT_lo + kT_bin_width;
            double kT_m  = kt_centers[ibin];
            double mT    = sqrt(kT_m*kT_m + m_pi*m_pi);

            // Find index in stored vectors
            int idx = -1;
            for (size_t j = 0; j < mt_vals.size(); j++) {
                if (fabs(mt_vals[j] - mT) < 0.01) { idx = j; break; }
            }
            if (idx < 0) continue;

            double fit_max_disp = sqrt(2500.0 / mT);

            TCanvas* cSample = new TCanvas(
                Form("cDrho_kT%d", ibin),
                Form("D(rho) with fit, kT=%.2f-%.2f GeV/c", kT_lo, kT_hi),
                1800, 600);
            cSample->Divide(3, 1);

            TH1F* hists[3] = {hOut_all[ibin], hSide_all[ibin], hLong_all[ibin]};
            double Rvals[3] = {Rout_vals[idx], Rside_vals[idx], Rlong_vals[idx]};
            double Rerrs[3] = {Rout_err_vals[idx], Rside_err_vals[idx], Rlong_err_vals[idx]};
            string dirNames[3] = {"out", "side", "long"};

            for (int idir = 0; idir < 3; idir++) {
                cSample->cd(idir + 1);
                gPad->SetLogx();
                gPad->SetLogy();
                gPad->SetLeftMargin(0.15);

                // Clone and normalise over the FIT RANGE, exactly as in the first code.
                TH1F* h = (TH1F*)hists[idir]->Clone();
                h->SetDirectory(0);

                // Normalize over the full source up to rhoLamMax.
                // Fix: use bin index 1 (not the rho value 0.1) as lower edge.
                const int firstPhysicalBin = 1;

                int lastLambdaBin =
                    h->FindBin(1e12);

                if (lastLambdaBin > h->GetNbinsX()) {
                    lastLambdaBin = h->GetNbinsX();
                }

                double normalizationCount =
                    h->Integral(firstPhysicalBin, lastLambdaBin);

                if (normalizationCount > 0.0) {
                    h->Scale(1.0 / normalizationCount, "width");
                }

                const double display_fit_min = 0.1;

                h->SetMinimum(1e-25);
                h->SetMaximum(1e0);
                h->GetXaxis()->SetRangeUser(0.1, 1e15);
                h->SetLineColor(kBlack);
                h->SetLineWidth(1);
                h->SetMarkerStyle(20);
                h->SetMarkerSize(0.4);
                h->SetMarkerColor(kBlack);
                h->SetTitle(Form("D(#rho);#rho_{%s} [fm];D(#rho)",
                                 dirNames[idir].c_str()));
                h->Draw("E1");

                // Draw Lévy fit function using parameters from 1mm cutoff
                double pars[3] = {alpha_vals[idx], Rvals[idir], lambda_by_cutoff["1mm"][idx]};
                TF1* func = new TF1(
                    Form("func_%s_kT%d", dirNames[idir].c_str(), ibin),
                    [&](double* x, double* par_fit) {
                        return LevyProj1DFunc(x, par_fit);
                    },
                    0.1, 1e6, 3);
                func->SetParameters(pars);
                func->SetLineColor(kRed);
                func->SetLineWidth(2);
                func->Draw("SAME");

                // Fit range vertical line
                TLine* lFitMax = new TLine(fit_max_disp, 1e-25, fit_max_disp, 1e0);
                lFitMax->SetLineColor(kGray + 2);
                lFitMax->SetLineStyle(7);
                lFitMax->Draw("SAME");
            }

            // Info box (similar to SMASH)
            cSample->cd(3);
            TPaveText* infoS = new TPaveText(0.55, 0.55, 0.89, 0.89, "NDC");
            infoS->SetBorderSize(0);
            infoS->SetFillStyle(0);
            infoS->SetTextSize(0.035);
            infoS->AddText(Form("#alpha = %.3f #pm %.3f", alpha_vals[idx], alpha_err_vals[idx]));
            infoS->AddText(Form("R_{out} = %.2f #pm %.2f fm", Rout_vals[idx], Rout_err_vals[idx]));
            infoS->AddText(Form("R_{side} = %.2f #pm %.2f fm", Rside_vals[idx], Rside_err_vals[idx]));
            infoS->AddText(Form("R_{long} = %.2f #pm %.2f fm", Rlong_vals[idx], Rlong_err_vals[idx]));
            infoS->AddText(Form("#lambda = %.3f #pm %.3f",
                                lambda_by_cutoff["1mm"][idx],
                                lambda_err_by_cutoff["1mm"][idx]));
            infoS->AddText(Form("-logL/NDF: %.2f/%.0f", logL_vals[idx], ndf_vals[idx]));
            infoS->Draw();

            cSample->cd(1);
            TPaveText* infoSys = new TPaveText(0.55, 0.55, 0.89, 0.89, "NDC");
            infoSys->SetBorderSize(0);
            infoSys->SetFillStyle(0);
            infoSys->SetTextSize(0.035);
            infoSys->AddText(Form("kT: %.2f - %.2f GeV/c", kT_lo, kT_hi));
            infoSys->AddText(Form("#rho_{fit}^{max} = %.1f fm", fit_max_disp));
            infoSys->AddText(Form("N_{events} = %d", nEvents));
            infoSys->AddText(Form("N_{pairs} = %d", pair_count_per_bin[ibin]));
            infoSys->Draw();

            cSample->SaveAs(Form("EPOS_Drho_kT%.2f_%.2f_cutoff.png", kT_lo, kT_hi));
            delete cSample;
        }
        cout << "\nSaved D(rho) canvases" << endl;
    }

    // ============================================================
    // mT vs fit parameters (4-pad) using 1mm cutoff lambda
    // ============================================================
    int nPoints2 = mt_vals.size();
    if (nPoints2 >= 2) {
        TCanvas* c_mT = new TCanvas("c_mT", "Fit Parameters vs m_T", 1600, 1200);
        c_mT->Divide(2, 2);

        vector<double> mt_e(nPoints2, 0.0);

        // Pad 1: alpha
        c_mT->cd(1);
        TGraphErrors* gAlpha = new TGraphErrors(nPoints2,
            &mt_vals[0], &alpha_vals[0],
            &mt_e[0],    &alpha_err_vals[0]);
        gAlpha->SetTitle("#alpha vs m_{T}; m_{T} [GeV/c^{2}]; #alpha");
        gAlpha->SetMarkerStyle(20);
        gAlpha->SetMarkerColor(kBlack);
        gAlpha->GetHistogram()->GetYaxis()->SetRangeUser(0.5, 2.5);
        gAlpha->Draw("AP");

        // Pad 2: Radii
        c_mT->cd(2);
        TGraphErrors* gRout = new TGraphErrors(nPoints2,
            &mt_vals[0], &Rout_vals[0],
            &mt_e[0],    &Rout_err_vals[0]);
        gRout->SetMarkerStyle(21); gRout->SetMarkerColor(kRed);
        gRout->SetLineColor(kRed);
        gRout->SetTitle("HBT radii vs m_{T}; m_{T} [GeV/c^{2}]; R [fm]");

        TGraphErrors* gRside = new TGraphErrors(nPoints2,
            &mt_vals[0], &Rside_vals[0],
            &mt_e[0],    &Rside_err_vals[0]);
        gRside->SetMarkerStyle(22); gRside->SetMarkerColor(kBlue);
        gRside->SetLineColor(kBlue);

        TGraphErrors* gRlong = new TGraphErrors(nPoints2,
            &mt_vals[0], &Rlong_vals[0],
            &mt_e[0],    &Rlong_err_vals[0]);
        gRlong->SetMarkerStyle(23); gRlong->SetMarkerColor(kGreen+2);
        gRlong->SetLineColor(kGreen+2);

        gRout->GetHistogram()->GetYaxis()->SetRangeUser(0.5, 35.0);
        gRout->Draw("AP");
        gRside->Draw("P SAME");
        gRlong->Draw("P SAME");

        TLegend* legR = new TLegend(0.65, 0.70, 0.88, 0.88);
        legR->SetBorderSize(0); legR->SetFillStyle(0);
        legR->AddEntry(gRout,  "R_{out}",  "P");
        legR->AddEntry(gRside, "R_{side}", "P");
        legR->AddEntry(gRlong, "R_{long}", "P");
        legR->Draw();

        // Pad 3: lambda (1mm cutoff)
        c_mT->cd(3);
        // Extract 1mm lambda values (must exist)
        const auto& lam1mm = lambda_by_cutoff["1mm"];
        const auto& lam1mmErr = lambda_err_by_cutoff["1mm"];
        if (lam1mm.size() == nPoints2) {
            TGraphErrors* gLambda = new TGraphErrors(nPoints2,
                &mt_vals[0], &lam1mm[0],
                &mt_e[0],    &lam1mmErr[0]);
            gLambda->SetTitle("#lambda_{1mm} vs m_{T}; m_{T} [GeV/c^{2}]; #lambda");
            gLambda->SetMarkerStyle(20); gLambda->SetMarkerColor(kBlack);
            gLambda->Draw("AP");
        } else {
            TPaveText* warn = new TPaveText(0.15, 0.45, 0.85, 0.60, "NDC");
            warn->SetBorderSize(0); warn->SetFillStyle(0);
            warn->AddText("Incomplete #lambda results for 1mm");
            warn->Draw();
        }

        // Pad 4: system info
        c_mT->cd(4);
        gPad->SetFillColor(0); gPad->SetFrameBorderMode(0);
        TPaveText* sysInfo = new TPaveText(0.10, 0.10, 0.90, 0.90, "NDC");
        sysInfo->SetTextSize(0.045); sysInfo->SetFillColor(0);
        sysInfo->SetBorderSize(1); sysInfo->SetTextFont(42); sysInfo->SetTextAlign(12);
        sysInfo->AddText("System Information");
        sysInfo->AddText("---------------------------");
        sysInfo->AddText("EPOS Au+Au 0-5%");
        sysInfo->AddText("#sqrt{s_{NN}} = 200 GeV");
        sysInfo->AddText(" ");
        sysInfo->AddText(Form("N_{events} = %d", nEvents));
        sysInfo->AddText(Form("Total pairs: %lld", total_pairs_all));
        sysInfo->AddText(Form("kT bins with fits: %d / %d", nPoints2, nBins_kT));
        sysInfo->AddText(" ");
        sysInfo->AddText("Kinematic cuts:");
        sysInfo->AddText(Form("%.2f < p_{T} < %.2f GeV/c", pT_min, pT_max));
        sysInfo->AddText(Form("|#eta| < %.1f", eta_cut));
        sysInfo->AddText(" ");
        sysInfo->AddText("EPOS ID: #pi^{+} = 120, #pi^{-} = -120");
        sysInfo->AddText("ist = 0 (final state)");
        sysInfo->Draw();

        c_mT->SaveAs("EPOS_mT_params_cutoff.png");
        cout << "\nSaved: EPOS_mT_params_cutoff.png" << endl;
    }

    sw.Stop();
    sw.Print();
}
